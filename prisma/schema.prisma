generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id     Int    @id @default(autoincrement())
  userId Int
  name   String
}

model Group {
  id     Int    @id @default(autoincrement())
  userId Int
  name   String
}

model Task {
  id           Int     @id @default(autoincrement())
  userId       Int
  name         String?
  groupName    String
  groupId      Int
  activityName String
  activityId   Int
  member       String
  dueDate      String
  type         String
  location     String?
}

model User {
  id                          Int                       @id @default(autoincrement())
  name                        String?
  email                       String                    @unique
  password                    String?
  userType                    UserType
  link                        String?
  subscriptionType            SubscriptionType
  lastPaymentDate             DateTime?
  cancellationReason          String?
  otp                         String?
  otpExpiration               DateTime?
  createdAt                   DateTime                  @default(now())
  isDisabled                  Boolean                   @default(false)
  passwordResetToken          String?
  passwordResetTokenExpiresAt DateTime?
  deviceTokens                DeviceToken[]
  locationResponsesAsAdmin    LocationRequestResponse[] @relation("LocationResponseAdmin")
  locationResponsesAsUser     LocationRequestResponse[] @relation("LocationResponseUser")
  subscriptions               Subscription[]
}

model Subscription {
  id                 Int       @id @default(autoincrement())
  userId             Int
  razorpayCustomerId String
  planId             String
  startDate          DateTime  @default(now())
  endDate            DateTime?
  amount             Int
  status             String
  autoRenew          Boolean   @default(true)
  renewalCount       Int       @default(0)
  payments           Payment[]
  user               User      @relation(fields: [userId], references: [id])
}

model Payment {
  id                Int          @id @default(autoincrement())
  subscriptionId    Int
  amount            Int
  paymentDate       DateTime     @default(now())
  status            String
  razorpayPaymentId String?
  subscription      Subscription @relation(fields: [subscriptionId], references: [id])
}

model Link {
  id            Int       @id @default(autoincrement())
  link          String    @unique
  owner         String?
  taskname      String?
  member        String?
  group         String?
  duedate       String?
  completeddate String?
  location      String?
  freecount     Int       @default(5)
  subscription  String?
  expiresAt     DateTime?
  isAccessed    Int       @default(0)
  taskId        Int?
}

model paidmemberdata {
  id       Int    @id @default(autoincrement())
  link     String
  otp      String
  otpcount Int    @default(1)
}

model Ad {
  id         Int      @id @default(autoincrement())
  contentUrl String
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DeviceToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  taskId    Int?
  userId    Int?
  platform  String   @default("unknown")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])

  @@index([taskId])
}

model LocationRequestResponse {
  id          Int      @id @default(autoincrement())
  requestId   String
  adminId     Int
  userId      Int
  status      String
  latitude    Float?
  longitude   Float?
  accuracy    Float?
  notes       String?
  respondedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  admin       User     @relation("LocationResponseAdmin", fields: [adminId], references: [id])
  user        User     @relation("LocationResponseUser", fields: [userId], references: [id])

  @@index([requestId])
  @@index([userId])
  @@index([adminId])
}

enum UserType {
  Superadmin
  Admin
  User
}

enum SubscriptionType {
  Free
  Professional_monthly
  Professional_yearly
  Premium_monthly
  Premium_yearly
}
